# Copy to .env and fill in. Load with:  set -a; source .env; set +a
# (Do NOT commit the real .env — it's gitignored.)

# --- dbt ---
export DBT_PROFILES_DIR="$(pwd)"
export DBT_THREADS=1                 # serial timing; concurrency harness overrides

# --- Source data location (the already-replicated tables) ---
# Set these to wherever the loaded tables live ON THE TARGET YOU'RE RUNNING.
# Easiest: re-export with the right values before each target's run, or keep
# them equal if both engines use the same db/schema names.
export SRC_DATABASE=""
export SRC_SCHEMA=""

# --- Snowflake ---
export SF_ACCOUNT=""                 # e.g. abc12345.eu-west-1
export SF_USER=""
export SF_PASSWORD=""
export SF_ROLE=""
export SF_WAREHOUSE=""               # document size — needed for cost-parity framing
export SF_DATABASE=""
export SF_SCHEMA="poc_bench"

# --- Snowflake CI auth (Option 2, used by the snowflake_ci target) ---
# Local dev uses externalbrowser (above); CI can't, so the snowflake_ci target
# authenticates as a LEGACY_SERVICE user with SF_USER + SF_PASSWORD. In GitHub
# Actions these come from repo secrets, not this file.

# --- Snowflake key pair auth (Option 3, used by the snowflake_keypair target) ---
# Non-interactive, no shared password. Register the PUBLIC key on the user
# (ALTER USER ... SET RSA_PUBLIC_KEY, needs USERADMIN); keep the PRIVATE key local.
# Generate:  openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out rsa_key.p8
#            openssl rsa -in rsa_key.p8 -pubout -out rsa_key.pub
export SF_PRIVATE_KEY_PATH=""         # path to the .p8 private key
export SF_PRIVATE_KEY_PASSPHRASE=""   # leave blank if the key is unencrypted (-nocrypt)

# --- Redshift serverless ---
export RS_HOST=""                    # serverless workgroup endpoint
export RS_PORT=5439
export RS_USER=""
export RS_PASSWORD=""
export RS_DATABASE=""
export RS_SCHEMA="poc_bench"
